{
    "name": "liteloader-qqnt-webui",
    "version": "1.0.0",
    "private": true,
    "description": "LiteLoaderQQNT 的浏览器管理界面插件：本机 HTTP 服务 + Vue 3 单页界面。",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/coolxitech/LiteLoaderQQNT-WebUI.git"
    },
    "keywords": [
        "liteloader",
        "qqnt",
        "webui"
    ],
    "author": "coolxitech",
    "scripts": {
        "dev": "vite",
        "type-check": "vue-tsc --noEmit -p tsconfig.webui.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
        "build:main": "tsc -p tsconfig.main.json",
        "build:renderer": "tsc -p tsconfig.renderer.json",
        "build:webui": "vite build",
        "build": "npm run type-check && npm run build:main && npm run build:renderer && npm run build:webui"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vueuse/core": "^15.0.0",
        "animate.css": "^4.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^0.577.0",
        "reka-ui": "^2.11.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.7",
        "vue": "^3.5.45",
        "vue-tsc": "^3.3.14"
    }
}
